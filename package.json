{
  "name": "ouroboros-timelines",
  "version": "0.1.5",
  "description": "Ouroboros Timelines for Obsidian: custom calendars, nested eras, span threads and linked notes, with native .ob files and optional legacy Evra compatibility.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint src",
    "check": "npm run build && npm run lint && npm test",
    "install-vault": "node scripts/install-to-vault.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "big-world": "esbuild scripts/big-world.ts --bundle --platform=node --outfile=test-dist/big-world.cjs --log-level=error && node test-dist/big-world.cjs",
    "e2e": "node tests/e2e/run.mjs",
    "banner": "node scripts/banner/build.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "timeline",
    "worldbuilding",
    "calendar",
    "fantasy-calendar",
    "eras",
    "ttrpg",
    "writing"
  ],
  "author": "Fatin Hossain",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CatapultTV/Ouroboros-Timeline.git"
  },
  "homepage": "https://github.com/CatapultTV/Ouroboros-Timeline",
  "bugs": {
    "url": "https://github.com/CatapultTV/Ouroboros-Timeline/issues"
  }
}
